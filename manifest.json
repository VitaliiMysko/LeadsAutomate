{
  "manifest_version": 3,
  "name": "Leads Automate",
  "version": "0.9.0",
  "description": "Side panel for LinkedIn Sales Navigator people search: prioritizes job titles, searches company by company, exports to CSV.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "leads-automate@future-processing.com",
      "strict_min_version": "128.0"
    }
  },
  "key": "",
  "permissions": ["sidePanel", "storage", "webRequest"],
  "host_permissions": [
    "https://www.linkedin.com/sales/*",
    "https://www.linkedin.com/sales-api/*",
    "https://www.linkedin.com/company/*",
    "https://www.linkedin.com/showcase/*",
    "https://www.linkedin.com/school/*",
    "https://media.licdn.com/*"
  ],
  "icons": {
    "16": "assets/icons/logo-16.png",
    "32": "assets/icons/logo-32.png",
    "48": "assets/icons/logo-48.png",
    "128": "assets/icons/logo-128.png"
  },
  "action": {
    "default_title": "Leads Automate (Sales Navigator)",
    "default_icon": {
      "16": "assets/icons/logo-16.png",
      "32": "assets/icons/logo-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sidebar_action": {
    "default_title": "Leads Automate (Sales Navigator)",
    "default_panel": "sidepanel.html",
    "default_icon": {
      "16": "assets/icons/logo-16.png",
      "32": "assets/icons/logo-32.png"
    },
    "open_at_install": false
  },
  "background": {
    "scripts": ["src/background.js"],
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/sales/*"],
      "js": [
        "src/content/selectors.js",
        "src/content/dom-utils.js",
        "src/content/sales-search.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
